# Test environment file for MCP Figma server
# Replace with your actual Figma API token for testing
FIGMA_API_KEY=your_figma_personal_access_token_here

# Security settings for local VM testing
NODE_ENV=development
LOG_LEVEL=info

# Rate limiting
MAX_REQUESTS_PER_MINUTE=100
MAX_CONCURRENT_REQUESTS=10

# Server configuration for VM
BIND_HOST=127.0.0.1
BIND_PORT=3000
